# Remotesmith development settings.
#
# Copy to `.env` (gitignored) and fill in the real value. This file carries a
# placeholder only: never a real address (agent.md §3).

# The TV box's network ADB endpoint (agent.md §4.3). It is a setting because it
# is an address on your own network.
BOX_ADB=<box-ip>:5555
